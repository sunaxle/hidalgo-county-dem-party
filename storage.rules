rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /voicemails/{fileName} {
      // Reduced from 50MB to 5MB to prevent storage abuse and massive Gemini API bills
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow read, update, delete: if false;
    }
    match /community-photos/{fileName} {
      allow read: if true;
      // Reduced from 10MB to 3MB to prevent storage abuse
      allow create: if request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
