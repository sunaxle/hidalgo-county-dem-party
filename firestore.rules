rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /officials_directory/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Protect form submissions from public read/download (data leak).
    match /form_submissions/{document=**} {
      allow create: if true; // Public can submit
      allow read, update, delete: if request.auth != null; // Only admins can read/manage
    }
    
    // Protect mail triggers from spam
    match /mail/{document=**} {
      allow create, read, update, delete: if request.auth != null;
    }
    
    // Community stories are public, but restrict modifications
    match /community_stories/{document=**} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Secure the CRM Contacts Collection
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
      
      // Subcollection for activity logs
      match /activity_log/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
