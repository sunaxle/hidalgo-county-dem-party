rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /officials_directory/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Form submissions inbox: allow public create and authorized portal read
    match /form_submissions/{document=**} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Protect mail triggers
    match /mail/{document=**} {
      allow create, read, write: if true;
    }
    
    // Community stories are public, but restrict modifications
    match /community_stories/{document=**} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // CRM Contacts Collection
    match /contacts/{contactId} {
      allow read, write: if true;
      
      // Subcollection for activity logs
      match /activity_log/{logId} {
        allow read, write: if true;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
